# ── Practice:Pace environment variables ──────────────────────────────────────
# Names only — never commit values. Set these in
# Vercel → Project → Settings → Environment Variables.
#
# The VITE_ prefix is not cosmetic: Vite inlines any VITE_* variable into the
# browser bundle, so anything with that prefix is PUBLIC. Everything without it
# is readable only by the serverless functions in api/.

# ── Supabase: client (public — these ship in the bundle) ─────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Supabase: server only ────────────────────────────────────────────────────
# Bypasses row-level security. Never give this a VITE_ prefix and never expose
# it to the browser. Read by every endpoint in api/.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe: server only ──────────────────────────────────────────────────────
# STRIPE_SECRET_KEY must match the mode of the price IDs below — a live key
# will not accept a test price, and vice versa.
STRIPE_SECRET_KEY=

# Per-endpoint and per-mode. The secret from the test-mode webhook endpoint
# will not verify live-mode events, so this changes when you go live.
STRIPE_WEBHOOK_SECRET=

# The two published plans. Deliberately NOT VITE_-prefixed: the client sends a
# plan key ('individual' | 'school') and api/stripe-checkout.js resolves it to
# a price here. A price ID in the browser bundle is one the caller can swap.
# Also read by api/stripe-webhook.js to map a price back to accounts.plan_tier,
# and by api/add-program.js as a fallback for the program cap.
STRIPE_PRICE_INDIVIDUAL=
STRIPE_PRICE_SCHOOL=
